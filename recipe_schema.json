{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecipeSuggestions",
  "type": "object",
  "required": ["recipes"],
  "additionalProperties": false,
  "properties": {
    "recipes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "description",
          "ingredients_used",
          "missing_ingredients",
          "instructions",
          "prep_time_minutes",
          "cook_time_minutes",
          "servings",
          "tips"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the recipe."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "A 2-3 sentence description of the dish including flavor profile."
          },
          "ingredients_used": {
            "type": "array",
            "minItems": 1,
            "description": "Pantry ingredients used in this recipe with specific amounts.",
            "items": {
              "type": "object",
              "required": ["item", "amount", "unit", "preparation"],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Name of the ingredient."
                },
                "amount": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Quantity of the ingredient (e.g. '2', '0.5', '1/4')."
                },
                "unit": {
                  "type": "string",
                  "description": "Unit of measurement (e.g. 'lbs', 'cloves', 'g'). Empty string if countable with no unit."
                },
                "preparation": {
                  "type": "string",
                  "description": "How the ingredient should be prepared (e.g. 'minced', 'cut into 1-inch cubes'). Empty string if no prep needed."
                }
              }
            }
          },
          "missing_ingredients": {
            "type": "array",
            "description": "Ingredients not in the pantry but needed or helpful for the recipe.",
            "items": {
              "type": "object",
              "required": ["item", "amount", "unit", "substitute"],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Name of the missing ingredient."
                },
                "amount": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Quantity needed."
                },
                "unit": {
                  "type": "string",
                  "description": "Unit of measurement. Empty string if countable with no unit."
                },
                "substitute": {
                  "type": "string",
                  "description": "Suggested substitute or workaround using pantry items. Empty string if no substitute exists."
                }
              }
            }
          },
          "instructions": {
            "type": "array",
            "minItems": 6,
            "maxItems": 10,
            "description": "Step-by-step cooking instructions with temperatures, timing, and visual cues.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prep_time_minutes": {
            "type": "integer",
            "minimum": 1,
            "description": "Preparation time in minutes."
          },
          "cook_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "description": "Cooking time in minutes."
          },
          "servings": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of servings the recipe produces."
          },
          "tips": {
            "type": "string",
            "description": "Optional tip about storage, variation, or technique. Empty string if none."
          }
        }
      }
    }
  }
}
